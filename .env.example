NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Firebase (client analytics only)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Postgres
# Runtime uses the Supabase transaction pooler (:6543, ?pgbouncer=true).
DATABASE_URL=
# DDL only. Supabase session pooler (:5432) — migrations must not run through
# the transaction pooler.
DATABASE_URL_DIRECT=

# Payload
PAYLOAD_SECRET=
PAYLOAD_PREVIEW_SECRET=
# Guards /api/payload-jobs/run and /handle-schedules.
CRON_SECRET=
# Vercel Blob. Unset locally: uploads fall back to disk under /media.
BLOB_READ_WRITE_TOKEN=

# Seed only, never deployed.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# GitHub (project star counts; optional — degrades to no counts)
GITHUB_TOKEN=
